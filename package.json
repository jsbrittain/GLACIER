{
  "name": "GLACIER",
  "version": "0.1.0",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:backend": "tsc",
    "build:frontend": "vite build",
    "build:bundle": "node scripts/prepare_bundle.js",
    "build": "npm run build:backend && npm run build:frontend && npm run build:bundle",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "npm run build && electron .",
    "test": "vitest run  --coverage",
    "dist": "npm run build && electron-builder",
    "server": "npm run build && cd api-server && npm install && npm run dev"
  },
  "author": "ARTIC Kraemer Lab",
  "license": "ISC",
  "description": "Graphical Launchpad for Analysis Computation Inference and Explication of Results",
  "build": {
    "appId": "com.ARTIC-Kraemer-Lab.GLACIER",
    "productName": "GLACIER",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "bundle",
        "to": "bundle"
      }
    ],
    "asarUnpack": [
      "bundle/**"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/dockerode": "^3.3.42",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.12",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^3.2.4",
    "css.escape": "^1.5.1",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "prettier": "^3.6.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@jsonforms/core": "^3.7.0-alpha.1",
    "@jsonforms/material-renderers": "^3.7.0-alpha.1",
    "@jsonforms/react": "^3.7.0-alpha.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@mui/system": "^7.3.7",
    "@mui/x-tree-view": "^8.27.1",
    "@vitejs/plugin-react": "^4.6.0",
    "ajv": "^8.17.1",
    "ansi-to-html": "^0.7.2",
    "date-fns": "^4.1.0",
    "dockerode": "^4.0.7",
    "dompurify": "^3.2.7",
    "electron-store": "8.2.0",
    "hast-util-sanitize": "^5.0.2",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-resources-to-backend": "^1.2.1",
    "isomorphic-git": "^1.32.1",
    "js-yaml": "^4.1.1",
    "platformdirs": "^4.3.8-rc3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.7.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "slash": "^5.1.0",
    "typescript": "^5.9.3",
    "unique-names-generator": "^4.7.1",
    "unist-util-visit": "^5.0.0",
    "vite": "^7.1.11"
  }
}
